# ====================================================================
# FINPRO — ENVIRONMENT CONFIGURATION TEMPLATE
# Project: FinPro — Personal Finance & Investment Decision Support Platform
# Branding: Created by Students of VU
# Project Lead: Jinay Golecha
# ====================================================================
# Copy this file to .env and configure your values.
# NEVER commit real credentials, passwords, or API keys to Git.
# ====================================================================

# --------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (REQUIRED)
# --------------------------------------------------------------------
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://127.0.0.1:5001

# --------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED — CONTROLS ENVIRONMENT TIER)
# PostgreSQL via Prisma ORM
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?<PARAMS>
# --------------------------------------------------------------------
# [Option A: Local Development PostgreSQL]
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/finance_jinay?schema=public"

# [Option B: Managed Cloud PostgreSQL — Render PostgreSQL (what production uses)]
# Render's *internal* URL is consumed directly by the web service in the same
# region, so it needs no SSL parameter:
# DATABASE_URL="postgresql://finpro:YOUR_PASSWORD@dpg-xxxxxxxx-a/finance_jinay"
# Other managed providers (Neon / Supabase / AWS RDS / OCI) also work — use their
# connection string and add ?sslmode=require where they require it.

# [Option C: Cloud PostgreSQL behind a transaction-mode pooler (PgBouncer)]
# DATABASE_URL="postgresql://finpro_prod:YOUR_PROD_PASSWORD@db.yourdomain.com:6543/finance_jinay?pgbouncer=true&sslmode=require&schema=public"

# [Migration connection (optional)] Only needed when DATABASE_URL uses a pooler
# that cannot execute DDL — notably Supabase's transaction pooler on port 6543.
# Render PostgreSQL's internal URL is a direct connection and does NOT need this.
# Otherwise, point it at the direct connection (db.<ref>.supabase.co:5432) or the
# session pooler (<pooler-host>:5432). Deploy-time reconciliation
# (node-backend/scripts/deploy-migrate.js) derives the session pooler from
# DATABASE_URL automatically when this is unset.
# DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# --------------------------------------------------------------------
# 3. CLOUD OBJECT STORAGE ABSTRACTION (PHASE 2)
# Controls storage for receipts, generated financial reports, and exports.
# --------------------------------------------------------------------
# Provider options: "local" (default for development) | "s3" (production cloud object store)
STORAGE_PROVIDER=local

# Local storage configuration (used when STORAGE_PROVIDER=local)
STORAGE_LOCAL_DIR=uploads

# S3-Compatible Cloud Object Storage (used when STORAGE_PROVIDER=s3)
# Compatible with: AWS S3, Cloudflare R2, Oracle Cloud Infrastructure Object Storage, MinIO, Backblaze B2
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=finpro-cloud-documents
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
S3_FORCE_PATH_STYLE=false
# Optional public CDN/base URL for serving files (leave blank to use signed URLs)
S3_PUBLIC_URL=

# --------------------------------------------------------------------
# 4. AUTHENTICATION & JWT SECURITY (REQUIRED)
# --------------------------------------------------------------------
JWT_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------------------------------
# 6. ARTIFICIAL INTELLIGENCE — GOOGLE GEMINI (OPTIONAL)
# If unconfigured, the backend uses deterministic rule-based advisory grounded in user data.
# --------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=gemini-1.5-flash
# Safety bounds (optional; defaults shown). Tokens are clamped to 30s–15min;
# the assistant deadline is clamped to 5s–120s and shared across retries/tools.
AI_ACTION_TOKEN_TTL_MS=300000
AI_ASSISTANT_TOTAL_TIMEOUT_MS=45000

# --------------------------------------------------------------------
# 7. MARKET DATA APIS (OPTIONAL)
# Real-time and historical quotes for NSE/BSE, COMEX Gold/Silver, FX.
# --------------------------------------------------------------------
MARKET_DATA_API_KEY=YOUR_MARKET_DATA_API_KEY
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY
# Gold/silver and the Pune retail estimate reuse these feeds.
# No separate metals-provider key is required.

# --------------------------------------------------------------------
# 8. FINANCIAL NEWS — MARKETAUX API (OPTIONAL)
# Real-time financial headlines and market sentiment.
# --------------------------------------------------------------------
MARKETAUX_API_KEY=YOUR_MARKETAUX_API_KEY

# --------------------------------------------------------------------
# 9. OCR RECEIPT SCANNER (OPTIONAL)
# Tesseract OCR operates locally in-memory; external OCR API keys if configured.
# --------------------------------------------------------------------
OCR_API_KEY=YOUR_OCR_API_KEY

# --------------------------------------------------------------------
# 10. LOCALIZATION & SYSTEM SETTINGS
# --------------------------------------------------------------------
CURRENCY=INR
LOCALE=en-IN
TIMEZONE=Asia/Kolkata

# --------------------------------------------------------------------
# 11. FIREBASE ADMIN SDK (OPTIONAL — PUSH NOTIFICATIONS)
# Paste the service-account JSON as one line, or set it in the host's
# secret manager. Without it, push notifications are disabled and the
# rest of the API keeps working.
# --------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=YOUR_FIREBASE_SERVICE_ACCOUNT_JSON_STRING

# --------------------------------------------------------------------
# 12. RESILIENCE, OBSERVABILITY & OPERATIONS (ALL OPTIONAL)
# Redis is an optional accelerator. When absent or down, caching and rate
# limiting fall back to per-process memory; core endpoints keep working.
# --------------------------------------------------------------------
REDIS_URL=
CACHE_ENABLED=true
CACHE_KEY_PREFIX=finpro
CACHE_DEFAULT_TTL_MS=60000
CACHE_MEMORY_MAX_ENTRIES=500
CACHE_MAX_VALUE_BYTES=262144
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_FAILURE_THRESHOLD=3
REDIS_COOLDOWN_MS=30000

# Prometheus/OpenMetrics scrape endpoint: GET /metrics
# Set a long random token in production, otherwise the endpoint returns 404.
METRICS_TOKEN=

# Best-effort push retry queue (in-process; not durable across restarts).
PUSH_QUEUE_MAX=200
PUSH_CONCURRENCY=2
PUSH_MAX_ATTEMPTS=3
PUSH_RETRY_BASE_MS=500
PUSH_RETRY_MAX_MS=10000
PUSH_ATTEMPT_TIMEOUT_MS=10000
PUSH_DEDUPE_TTL_MS=300000

# Operator CLI only (not read by the server). Local backups by default.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_ALLOW_NON_LOCAL=false
# Optional client-tool timeouts (milliseconds):
# BACKUP_TIMEOUT_MS=600000
# RESTORE_TIMEOUT_MS=900000
# Optional overrides when PostgreSQL client tools are not on PATH:
# PG_DUMP_BIN=/usr/bin/pg_dump
# PG_RESTORE_BIN=/usr/bin/pg_restore
# PSQL_BIN=/usr/bin/psql

# Backup encryption (operator CLI only). 32 random bytes as base64 (or 64 hex
# chars). Generate on the backup host and store it in a secret manager:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# When set, backup-db.js encrypts with AES-256-GCM unless --no-encrypt is passed.
# Encrypted restores require the same key.
BACKUP_ENCRYPTION_KEY=

# Off-host backup publishing (operator CLI only). publish-backup.js accepts only
# encrypted finpro-*.dump.enc files with a valid manifest, uploads with
# server-side encryption, then downloads the object again and verifies SHA-256.
# Keep bucket versioning and lifecycle/retention rules enabled.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=finpro/postgres
BACKUP_S3_ENDPOINT=
BACKUP_AWS_REGION=
# AES256 is the default. Set to "none" only when the provider cannot do SSE
# (client-side AES-256-GCM still applies); document why.
BACKUP_S3_SSE=AES256
# BACKUP_S3_STORAGE_CLASS=
# BACKUP_UPLOAD_TIMEOUT_MS=900000
