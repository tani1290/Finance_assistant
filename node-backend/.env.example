# ====================================================================
# FINPRO — ENVIRONMENT CONFIGURATION TEMPLATE
# Project: FinPro — Personal Finance & Investment Decision Support Platform
# Branding: Created by Students of VU
# Project Lead: Jinay Golecha
# ====================================================================
# Copy this file to .env and configure your values.
# NEVER commit real credentials, passwords, or API keys to Git.
# ====================================================================

# --------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (REQUIRED)
# --------------------------------------------------------------------
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://127.0.0.1:5001

# --------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED)
# PostgreSQL via Prisma ORM
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# --------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/finance_jinay"

# --------------------------------------------------------------------
# 2b. MIGRATION CONNECTION (OPTIONAL — CLOUD POOLERS ONLY)
# Used by `npm run db:reconcile` (scripts/deploy-migrate.js) for schema
# migrations ONLY. Prisma cannot run DDL (CREATE/ALTER TABLE) through a
# transaction-mode pooler such as Supabase's port 6543, so point this at a
# direct connection (db.<ref>.supabase.co:5432) or the session pooler
# (aws-0-<region>.pooler.supabase.com:5432). Production runs on Render
# PostgreSQL's internal URL, which is direct, so it does NOT need this.
# Leave unset locally.
# --------------------------------------------------------------------
# DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# --------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY (REQUIRED)
# --------------------------------------------------------------------
JWT_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (REQUIRED FOR GOOGLE SIGN-IN)
# Configure Authorized JavaScript origins in Google Cloud Console:
# - http://localhost:5001
# - http://127.0.0.1:5001
# - https://finpro-finance-ai.onrender.com (Production)
# --------------------------------------------------------------------
GOOGLE_CLIENT_ID=1024776311502-8jld09q86kqeei2ud56krp4kb2sht67l.apps.googleusercontent.com

# --------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE — GOOGLE GEMINI (OPTIONAL)
# If unconfigured, the backend uses deterministic rule-based advisory grounded in user data.
# --------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=gemini-1.5-flash
# Safety bounds (optional; defaults shown). Tokens are clamped to 30s–15min;
# the assistant deadline is clamped to 5s–120s and shared across retries/tools.
AI_ACTION_TOKEN_TTL_MS=300000
AI_ASSISTANT_TOTAL_TIMEOUT_MS=45000

# --------------------------------------------------------------------
# 6. MARKET DATA APIS (OPTIONAL)
# Real-time and historical quotes for NSE/BSE, COMEX Gold/Silver, FX.
# --------------------------------------------------------------------
MARKET_DATA_API_KEY=YOUR_MARKET_DATA_API_KEY
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY

# --------------------------------------------------------------------
# 7. FINANCIAL NEWS — MARKETAUX API (OPTIONAL)
# Real-time financial headlines and market sentiment.
# --------------------------------------------------------------------
MARKETAUX_API_KEY=YOUR_MARKETAUX_API_KEY

# --------------------------------------------------------------------
# 8. OCR RECEIPT SCANNER (OPTIONAL)
# Tesseract OCR operates locally; external OCR API keys if configured.
# --------------------------------------------------------------------
OCR_API_KEY=YOUR_OCR_API_KEY

# --------------------------------------------------------------------
# 9. CLOUD OBJECT STORAGE (S3-COMPATIBLE)
# --------------------------------------------------------------------
STORAGE_PROVIDER=local # Options: local, s3
S3_ENDPOINT=https://your-s3-provider.example.com/finpro-documents
S3_REGION=ap-northeast-2
S3_BUCKET=finpro-documents
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key

# --------------------------------------------------------------------
# 10. LOCALIZATION & SYSTEM SETTINGS
# --------------------------------------------------------------------
CURRENCY=INR
LOCALE=en-IN
TIMEZONE=Asia/Kolkata

# --------------------------------------------------------------------
# 11. FIREBASE ADMIN SDK (Push Notifications + Auth Verification)
# Required for FCM push notifications and Firebase ID token validation.
# Steps:
#   1. Go to https://console.firebase.google.com/
#   2. Project Settings → Service Accounts → Generate new private key
#   3. Download the JSON file
#   4. Paste the ENTIRE file content as a single-line JSON string below
#      (replace newlines with \n) — or use the Render dashboard to paste multi-line
# --------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=YOUR_FIREBASE_SERVICE_ACCOUNT_JSON_STRING

# --------------------------------------------------------------------
# 12. RESILIENCE, OBSERVABILITY & OPERATIONS (ALL OPTIONAL)
# The app runs without every value in this section. Redis is an optional
# accelerator: when it is absent or down, caching and rate limiting fall
# back to per-process memory and core endpoints keep working.
# --------------------------------------------------------------------

# --- Optional shared cache / rate-limit store -----------------------
# Leave empty to use the in-process cache only.
REDIS_URL=
CACHE_ENABLED=true
CACHE_KEY_PREFIX=finpro
CACHE_DEFAULT_TTL_MS=60000
CACHE_MEMORY_MAX_ENTRIES=500
CACHE_MAX_VALUE_BYTES=262144
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_FAILURE_THRESHOLD=3
REDIS_COOLDOWN_MS=30000

# --- Metrics --------------------------------------------------------
# Prometheus/OpenMetrics text endpoint: GET /metrics
# Set a long random token to expose it in production. If unset in
# production the endpoint returns 404. Send it as:
#   Authorization: Bearer <token>   or   X-Metrics-Token: <token>
METRICS_TOKEN=

# --- Synthetic payment simulator (demo only) ------------------------
# This simulator never contacts a bank/card/UPI network, never moves real
# money and never accepts real card, CVV or UPI-PIN values. It is enabled by
# default outside production. In production it requires BOTH flags below;
# anything else leaves every mutating simulator route disabled (403).
# PAYMENT_SIMULATOR_ENABLED=true
# PAYMENT_SIMULATOR_ALLOW_PRODUCTION=true
# Optional bounds (whole/2-decimal rupees). Invalid values fall back safely.
# PAYMENT_SIMULATOR_MAX_AMOUNT=100000
# PAYMENT_SIMULATOR_SEED_AMOUNT=50000

# --- Push notification retry queue (best-effort, in-process) --------
# Queued notifications are NOT durable across restarts. See ../docs/OPERATIONS.md.
PUSH_QUEUE_MAX=200
PUSH_CONCURRENCY=2
PUSH_MAX_ATTEMPTS=3
PUSH_RETRY_BASE_MS=500
PUSH_RETRY_MAX_MS=10000
PUSH_ATTEMPT_TIMEOUT_MS=10000
PUSH_DEDUPE_TTL_MS=300000

# --- Backup / restore (operator CLI only; not read by the server) ---
# Local backups are the default. A non-local source needs BOTH
# --allow-non-local and BACKUP_ALLOW_NON_LOCAL=true. Restores are local-only.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_ALLOW_NON_LOCAL=false
# Optional client-tool timeouts (milliseconds):
# BACKUP_TIMEOUT_MS=600000
# RESTORE_TIMEOUT_MS=900000
# Optional overrides when PostgreSQL client tools are not on PATH:
# PG_DUMP_BIN=/usr/bin/pg_dump
# PG_RESTORE_BIN=/usr/bin/pg_restore
# PSQL_BIN=/usr/bin/psql

# --- Backup encryption (operator CLI only) ---------------------------
# 32 random bytes as base64 (or 64 hex chars). Generate once on the backup
# host and store it in the secret manager, never in git:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# When set, backup-db.js encrypts with AES-256-GCM unless --no-encrypt is
# passed explicitly. Encrypted restores require the same key.
BACKUP_ENCRYPTION_KEY=

# --- Off-host backup publishing (operator CLI only) ------------------
# scripts/publish-backup.js accepts only encrypted finpro-*.dump.enc files
# with a valid manifest. It uploads with server-side encryption, downloads
# the object again and verifies SHA-256 before reporting success.
# Keep bucket-level versioning and lifecycle/retention rules enabled.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=finpro/postgres
BACKUP_S3_ENDPOINT=
BACKUP_AWS_REGION=
# AES256 is the default. Set to "none" only if the provider cannot do SSE
# (client-side AES-256-GCM still applies), and document why.
BACKUP_S3_SSE=AES256
# BACKUP_S3_STORAGE_CLASS=
# BACKUP_UPLOAD_TIMEOUT_MS=900000

# --- Firebase (see section 11) --------------------------------------
# FIREBASE_SERVICE_ACCOUNT_JSON is defined above.
