// This is your Prisma schema file for Jinay Finance AI
// Owner: Jinay Golecha (jinay_golecha)
// Database: PostgreSQL (finance_jinay)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  password      String?  // null for Google OAuth users
  firstName     String   @default("")
  lastName      String   @default("")
  phone         String?
  avatarUrl     String?
  googleId      String?  @unique
  role          Role     @default(USER)
  isPremium     Boolean  @default(false)
  isActive      Boolean  @default(true)
  country       String   @default("India")
  timezone      String   @default("Asia/Kolkata")
  currency      String   @default("INR")
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  profile            Profile?
  financialProfile   FinancialProfile?
  financialPlan      FinancialPlan?
  accounts           FinancialAccount[]
  transactions       Transaction[]
  categories         Category[]
  budgets            Budget[]
  goals              Goal[]
  portfolio          Portfolio?
  loans              Loan[]
  insurancePolicies  InsurancePolicy[]
  subscriptions      Subscription[]
  calendarEvents     CalendarEvent[]
  notifications      Notification[]
  chatMessages       ChatMessage[]
  aiRecommendations  AIRecommendation[]
  watchlist          MarketWatchlist[]
  exportJobs         ExportJob[]
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]
  healthHistory      FinancialHealthHistory[]
  cashFlowPredictions CashFlowPrediction[]
  expenseAnomalies   ExpenseAnomaly[]
  financialSimulations FinancialSimulation[]
  recommendationFeedback AIRecommendationFeedback[]
  categoryCorrections TransactionCategoryCorrection[]
  receiptScans       ReceiptScan[]
  trainingDatasets   TrainingDataset[]
  trainingRuns       TrainingRun[]
  mlPredictions      MLPrediction[]
  cards              Card[]
  financialTasks     FinancialTask[]
  mobileDevices      MobileDevice[]
  pendingSmsTransactions PendingSmsTransaction[]
  fcmTokens          FcmToken[]

  @@index([email])
  @@index([googleId])
  @@map("users")
}

enum Role {
  USER
  PREMIUM_USER
  FAMILY_ADMIN
  ADMIN
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model FcmToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String
  deviceId   String   @default("default")
  platform   String   @default("android") // android | ios | web
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("fcm_tokens")
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth      DateTime?
  occupation       String?
  bio              String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("profiles")
}

// ============================================================
// FINANCIAL ONBOARDING
// ============================================================

model FinancialProfile {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                       Int      @default(25)
  city                      String   @default("Mumbai")
  country                   String   @default("India")
  monthlySalary             Decimal  @default(0) @db.Decimal(15, 2)
  otherMonthlyIncome        Decimal  @default(0) @db.Decimal(15, 2)
  estimatedMonthlyExpenses  Decimal  @default(0) @db.Decimal(15, 2)
  currentSavings            Decimal  @default(0) @db.Decimal(15, 2)
  emergencyFund             Decimal  @default(0) @db.Decimal(15, 2)
  totalDebt                 Decimal  @default(0) @db.Decimal(15, 2)
  riskProfile               RiskProfile @default(MODERATE)
  budgetMethod              BudgetMethod @default(FIFTY_THIRTY_TWENTY)
  financialPriorities       String   @default("Save more, Build emergency fund")
  isOnboardingComplete      Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("financial_profiles")
}

enum RiskProfile {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum BudgetMethod {
  FIFTY_THIRTY_TWENTY
  ZERO_BASED
  CUSTOM
}

model FinancialPlan {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  income                Decimal  @default(0) @db.Decimal(15, 2)
  expenses              Decimal  @default(0) @db.Decimal(15, 2)
  savingsTarget         Decimal  @default(0) @db.Decimal(15, 2)
  emergencyFundTarget   Decimal  @default(0) @db.Decimal(15, 2)
  investmentTarget      Decimal  @default(0) @db.Decimal(15, 2)
  debtRepaymentTarget   Decimal  @default(0) @db.Decimal(15, 2)
  financialHealthScore  Int      @default(0) // 0-100
  riskProfile           String   @default("Moderate")
  budgetMethod          String   @default("50/30/20")
  planSummary           String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("financial_plans")
}

// ============================================================
// ACCOUNTS
// ============================================================

model FinancialAccount {
  id                  String      @id @default(uuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  institution         String?
  accountType         AccountType @default(BANK)
  accountNumberMasked String?
  balance             Decimal     @default(0) @db.Decimal(15, 2)
  currency            String      @default("INR")
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  transactions Transaction[]
  pendingSmsTransactions PendingSmsTransaction[]

  @@index([userId])
  @@map("financial_accounts")
}

enum AccountType {
  BANK
  CASH
  WALLET
  CREDIT_CARD
  SAVINGS
  CURRENT
  OTHER
}

// ============================================================
// TRANSACTIONS
// ============================================================

model Category {
  id           String          @id @default(uuid())
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  categoryType CategoryType    @default(EXPENSE)
  icon         String?
  color        String?
  isDefault    Boolean         @default(false)
  createdAt    DateTime        @default(now())

  transactions Transaction[]
  budgets      Budget[]

  @@index([userId])
  @@map("categories")
}

enum CategoryType {
  INCOME
  EXPENSE
  TRANSFER
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String?
  account         FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amount          Decimal         @db.Decimal(15, 2)
  transactionType TransactionType @default(EXPENSE)
  description     String?
  merchant        String?
  notes           String?
  paymentMethod   String?
  date            DateTime        @db.Date
  currency        String          @default("INR")
  isFraudSuspected Boolean        @default(false)
  aiCategory      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, transactionType])
  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  INVESTMENT
  LOAN_PAYMENT
}

// ============================================================
// BUDGETS
// ============================================================

model Budget {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName String   @default("General")
  monthlyLimit Decimal  @db.Decimal(15, 2)
  month        Int      // 1-12
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, categoryName, month, year])
  @@index([userId])
  @@map("budgets")
}

// ============================================================
// GOALS
// ============================================================

model Goal {
  id                    String     @id @default(uuid())
  userId                String
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  goalType              GoalType   @default(OTHER)
  targetAmount          Decimal    @db.Decimal(15, 2)
  currentAmount         Decimal    @default(0) @db.Decimal(15, 2)
  targetDate            DateTime?  @db.Date
  monthlyContribution   Decimal    @default(0) @db.Decimal(15, 2)
  priority              Priority   @default(MEDIUM)
  status                GoalStatus @default(ACTIVE)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([userId])
  @@map("goals")
}

enum GoalType {
  EMERGENCY_FUND
  VACATION
  HOME
  CAR
  EDUCATION
  RETIREMENT
  WEDDING
  INVESTMENT
  OTHER
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

// ============================================================
// INVESTMENTS
// ============================================================

model Portfolio {
  id             String     @id @default(uuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalInvested  Decimal    @default(0) @db.Decimal(15, 2)
  currentValue   Decimal    @default(0) @db.Decimal(15, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  investments Investment[]

  @@map("portfolios")
}

model Investment {
  id               String      @id @default(uuid())
  portfolioId      String
  portfolio        Portfolio   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol           String
  name             String?
  assetType        AssetType   @default(STOCK)
  quantity         Decimal     @db.Decimal(15, 6)
  averageBuyPrice  Decimal     @db.Decimal(15, 2)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([portfolioId, symbol])
  @@index([portfolioId])
  @@map("investments")
}

enum AssetType {
  STOCK
  MUTUAL_FUND
  SIP
  GOLD
  SILVER
  FIXED_DEPOSIT
  CRYPTO
  BOND
  ETF
  OTHER
}

model MarketWatchlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  name      String?
  addedAt   DateTime @default(now())

  @@unique([userId, symbol])
  @@index([userId])
  @@map("market_watchlist")
}

// ============================================================
// LOANS
// ============================================================

model Loan {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanType           LoanType  @default(PERSONAL)
  lenderName         String?
  principalAmount    Decimal   @db.Decimal(15, 2)
  interestRate       Decimal   @db.Decimal(5, 2)
  tenureMonths       Int
  startDate          DateTime  @db.Date
  emiAmount          Decimal?  @db.Decimal(15, 2)
  outstandingBalance Decimal   @db.Decimal(15, 2)
  status             LoanStatus @default(ACTIVE)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@map("loans")
}

enum LoanType {
  HOME
  CAR
  PERSONAL
  EDUCATION
  BUSINESS
  GOLD
  OTHER
}

enum LoanStatus {
  ACTIVE
  CLOSED
  DEFAULTED
}

// ============================================================
// INSURANCE & SUBSCRIPTIONS
// ============================================================

model InsurancePolicy {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyName     String
  insurer        String?
  policyType     String   @default("LIFE")
  policyNumber   String?
  beneficiary    String?
  coverageAmount Decimal  @db.Decimal(15, 2)
  premium        Decimal  @db.Decimal(15, 2)
  premiumCycle   String   @default("ANNUAL")
  renewalDate    DateTime @db.Date
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("insurance_policies")
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceName     String
  cost            Decimal  @db.Decimal(15, 2)
  billingCycle    String   @default("MONTHLY")
  nextBillingDate DateTime @db.Date
  category        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("subscriptions")
}

// ============================================================
// CALENDAR & NOTIFICATIONS
// ============================================================

model CalendarEvent {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  eventType   String    @default("CUSTOM")
  eventDate   DateTime  @db.Date
  amount      Decimal?  @db.Decimal(15, 2)
  isRecurring Boolean   @default(false)
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, eventDate])
  @@map("calendar_events")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  INFO
  WARNING
  ALERT
  SUCCESS
  BUDGET_WARNING
  BUDGET_EXCEEDED
  EMI_DUE
  SIP_DUE
  GOAL_MILESTONE
  STOCK_ALERT
  GOLD_ALERT
  SILVER_ALERT
  ANOMALY_DETECTED
  CASH_FLOW_ALERT
  SIMULATION_RESULT
}

// ============================================================
// AI
// ============================================================

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("user") // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("chat_messages")
}

model AIRecommendation {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  title       String
  description String
  priority    Priority @default(MEDIUM)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("ai_recommendations")
}

model AIRecommendationFeedback {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationId    String?
  recommendationTitle String
  feedbackType        String   // HELPFUL, NOT_HELPFUL, ALREADY_DONE
  comments            String?
  createdAt           DateTime @default(now())

  @@index([userId])
  @@map("ai_recommendation_feedback")
}

model FinancialHealthHistory {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  overallScore         Int
  savingsScore         Int      @default(0)
  debtScore            Int      @default(0)
  emergencyScore       Int      @default(0)
  investmentScore      Int      @default(0)
  goalScore            Int      @default(0)
  insuranceScore       Int      @default(0)
  cashFlowScore        Int      @default(0)
  subscriptionScore    Int      @default(0)
  dtiScore             Int      @default(0)
  incomeStabilityScore Int      @default(0)
  positiveReasons      String[] @default([])
  attentionReasons     String[] @default([])
  recommendations      String[] @default([])
  createdAt            DateTime @default(now())

  @@index([userId, createdAt])
  @@map("financial_health_history")
}

model CashFlowPrediction {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeframeDays    Int      // 7, 30, 90
  expectedIncome   Decimal  @db.Decimal(15, 2)
  expectedExpenses Decimal  @db.Decimal(15, 2)
  expectedBalance  Decimal  @db.Decimal(15, 2)
  lowBalanceDate   DateTime?
  lowBalanceAmount Decimal? @db.Decimal(15, 2)
  projections      Json
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("cash_flow_predictions")
}

model ExpenseAnomaly {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId   String?
  amount          Decimal  @db.Decimal(15, 2)
  category        String
  merchant        String?
  baselineAverage Decimal  @db.Decimal(15, 2)
  severity        String   @default("UNUSUAL") // NORMAL, UNUSUAL, HIGHLY_UNUSUAL
  reason          String
  userFeedback    String   @default("PENDING") // PENDING, CONFIRMED_NORMAL, SUSPICIOUS, IGNORED
  createdAt       DateTime @default(now())

  @@index([userId])
  @@map("expense_anomalies")
}

model FinancialSimulation {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioName     String
  scenarioType     String   // SALARY_INCREASE, EXPENSE_INCREASE, EXTRA_INVESTMENT, LOAN_PREPAY, MAJOR_PURCHASE, CUSTOM
  parameters       Json
  currentCashFlow  Decimal  @db.Decimal(15, 2)
  scenarioCashFlow Decimal  @db.Decimal(15, 2)
  currentNetWorth  Decimal  @db.Decimal(15, 2)
  scenarioNetWorth Decimal  @db.Decimal(15, 2)
  impactSummary    String
  detailedImpact   Json
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("financial_simulations")
}

model TransactionCategoryCorrection {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant          String?
  description       String?
  originalCategory  String
  correctedCategory String
  createdAt         DateTime @default(now())

  @@index([userId])
  @@map("transaction_category_corrections")
}

model ReceiptScan {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant      String?
  amount        Decimal? @db.Decimal(15, 2)
  date          DateTime? @db.Date
  category      String?
  items         Json?
  rawText       String?
  status        String   @default("PENDING_CONFIRMATION") // PENDING_CONFIRMATION, CONFIRMED, REJECTED
  transactionId String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("receipt_scans")
}

// ============================================================
// MARKET & COMMODITY PRICES
// ============================================================

model MarketPriceHistory {
  id        String   @id @default(uuid())
  symbol    String
  price     Decimal  @db.Decimal(15, 2)
  open      Decimal? @db.Decimal(15, 2)
  high      Decimal? @db.Decimal(15, 2)
  low       Decimal? @db.Decimal(15, 2)
  close     Decimal? @db.Decimal(15, 2)
  volume    BigInt?
  currency  String   @default("INR")
  provider  String   @default("Finnhub")
  timestamp DateTime @default(now())

  @@index([symbol, timestamp])
  @@map("market_price_history")
}

model CommodityPrice {
  id            String   @id @default(uuid())
  commodityType String   // GOLD_24K, GOLD_22K, SILVER
  pricePerGram  Decimal  @db.Decimal(15, 2)
  currency      String   @default("INR")
  provider      String   @default("MCX_Reference")
  timestamp     DateTime @default(now())

  @@index([commodityType, timestamp])
  @@map("commodity_prices")
}

// ============================================================
// EXPORTS & AUDIT
// ============================================================

model ExportJob {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exportType String   // transactions, accounts, budgets, etc.
  status     String   @default("pending")
  filePath   String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("export_jobs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("audit_logs")
}

// ============================================================
// TRAINING DATA BOT & ML PIPELINE
// ============================================================

model TrainingDataset {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  fileName       String?
  rowCount       Int              @default(0)
  columnCount    Int              @default(0)
  columns        Json             @default("[]")
  currentVersion Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  versions       DatasetVersion[]
  trainingRuns   TrainingRun[]

  @@index([userId])
  @@map("training_datasets")
}

model DatasetVersion {
  id            String          @id @default(uuid())
  datasetId     String
  dataset       TrainingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  versionNumber Int             @default(1)
  changeLog     String          @default("Initial upload")
  rowCount      Int             @default(0)
  columnCount   Int             @default(0)
  columns       Json            @default("[]")
  data          Json            @default("[]")
  createdAt     DateTime        @default(now())

  trainingRuns  TrainingRun[]

  @@unique([datasetId, versionNumber])
  @@map("dataset_versions")
}

model TrainingRun {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  datasetId        String
  dataset          TrainingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetVersionId String?
  datasetVersion   DatasetVersion? @relation(fields: [datasetVersionId], references: [id], onDelete: SetNull)
  taskType         String          // REGRESSION | CLASSIFICATION
  targetColumn     String
  featureColumns   String[]
  algorithm        String          // LINEAR_REGRESSION | RIDGE | DECISION_TREE | LOGISTIC_REGRESSION | NAIVE_BAYES
  hyperparameters  Json            @default("{}")
  metrics          Json            // Regression: { mae, mse, rmse, r2 } | Classification: { accuracy, precision, recall, f1 }
  modelVersion     String          @default("v1.0.0")
  status           String          @default("COMPLETED")
  errorMessage     String?
  modelWeights     Json?
  featureStats     Json?
  createdAt        DateTime        @default(now())

  predictions      MLPrediction[]

  @@index([userId])
  @@index([datasetId])
  @@map("training_runs")
}

model MLPrediction {
  id                 String      @id @default(uuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingRunId      String
  trainingRun        TrainingRun @relation(fields: [trainingRunId], references: [id], onDelete: Cascade)
  modelVersion       String
  algorithm          String
  inputValues        Json
  predictedValue     String
  numericPrediction  Float?
  confidenceScore    Float?
  performanceSummary Json?
  createdAt          DateTime    @default(now())

  @@index([userId])
  @@index([trainingRunId])
  @@map("ml_predictions")
}

// ============================================================
// CARDS & FINANCIAL TASKS (Phase 26 & Phase 29)
// ============================================================

model Card {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardNickname       String
  cardType           CardType  @default(CREDIT)
  issuer             String    // HDFC, SBI, ICICI, Axis, etc.
  lastFourDigits     String    // e.g. "4321" (NEVER store full PAN, CVV, or PIN)
  creditLimit        Decimal?  @db.Decimal(15, 2)
  outstandingAmount  Decimal   @default(0) @db.Decimal(15, 2)
  minimumDue         Decimal?  @db.Decimal(15, 2)
  billingCycleDay    Int?      // e.g. 15
  dueDate            DateTime? @db.Date
  rewardCategory     String?   // Dining, Travel, Fuel, Cashback
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@map("payment_cards")
}

enum CardType {
  CREDIT
  DEBIT
}

model FinancialTask {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  category     String       @default("GENERAL") // EMI, CREDIT_CARD, SIP, INSURANCE, SUBSCRIPTION, TAX, BUDGET
  dueDate      DateTime     @db.Date
  priority     Priority     @default(MEDIUM)
  isCompleted  Boolean      @default(false)
  completedAt  DateTime?
  reminderTime DateTime?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId])
  @@index([userId, isCompleted])
  @@map("financial_tasks")
}

// ============================================================
// MOBILE & SMS DETECTION (Phase 4 & 5)
// ============================================================

model MobileDevice {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String
  deviceModel String?
  osVersion   String?
  appVersion  String?
  fcmToken    String?
  lastSyncAt  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("mobile_devices")
}

model PendingSmsTransaction {
  id                     String            @id @default(uuid())
  userId                 String
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount                 Decimal           @db.Decimal(15, 2)
  currency               String            @default("INR")
  transactionType        TransactionType   @default(EXPENSE)
  merchant               String?
  accountHint            String?
  matchedAccountId       String?
  matchedAccount         FinancialAccount? @relation(fields: [matchedAccountId], references: [id], onDelete: SetNull)
  suggestedCategory      String?
  confidence             Decimal?          @db.Decimal(5, 4)
  categoryReason         String?
  status                 String            @default("PENDING") // PENDING, CONFIRMED, REJECTED
  source                 String            @default("BANK_SMS")
  rawSender              String?
  rawMessageHash         String?
  bankReference          String?
  transactionDate        DateTime          @default(now())
  confirmedTransactionId String?
  isDuplicate            Boolean           @default(false)
  duplicateReason        String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, rawMessageHash])
  @@index([userId, bankReference])
  @@map("pending_sms_transactions")
}

