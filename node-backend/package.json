{
  "name": "finpro-backend",
  "version": "1.1.0",
  "description": "FinPro — Personal Finance & Investment Decision Support Platform | Created by Students of VU (Node.js Backend)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node run-all-tests.js && node test-sms-mobile-suite.js",
    "test:sms": "node test-sms-mobile-suite.js",
    "test:cloud": "node test-cloud-verification.js",
    "test:failure": "node test-cloud-failure.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:reconcile": "node scripts/deploy-migrate.js",
    "db:reconcile:strict": "node scripts/deploy-migrate.js --strict",
    "build": "node scripts/build.js",
    "lint": "node scripts/lint.js && node scripts/scan-secrets.js"
  },
  "keywords": [
    "finance",
    "ai",
    "investment",
    "node",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Jinay Golecha <jinay_golecha>",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/*.test.js"
    ]
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
